{
  "name": "dsh-tauri-turnrewind",
  "type": "module",
  "version": "0.1.0-dev.4",
  "description": "Local turn-aware workspace undo for DeepSeek Harness",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "files": ["README.md", "cordis.patch.yml", "lib"],
  "dsh": {
    "runtime": "host",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "test": "vitest run test --testTimeout=30000"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
